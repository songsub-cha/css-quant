# Copy to .env and adjust for local use. Never commit the real .env.

# Backend origin the Vite dev server proxies /api requests to (see
# vite.config.ts). Defaults to http://localhost:8000, matching
# infra/docker-compose.dev.yml's api port. Override if the backend runs
# elsewhere (a different port, another host on the LAN, etc).
VITE_API_PROXY_TARGET=http://localhost:8000
